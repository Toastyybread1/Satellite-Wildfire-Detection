{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kaggle: Inspect Dataset Files",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "inspect"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Kaggle: Login",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "login"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Kaggle: Run Validation Tuning (GPU)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "run", "--experiment", "tuning", "--gpu"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Kaggle: Tuning Status",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "status", "--experiment", "tuning"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Kaggle: Download Tuning Reports",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "reports", "--experiment", "tuning"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Kaggle: Download Baseline Reports",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/kaggle_workspace.py", "reports", "--experiment", "baseline"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
